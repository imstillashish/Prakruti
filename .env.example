# Backend & Database Environment Variables Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env

# Flask Server Port
PORT=5001
FLASK_ENV=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://prakruti-ten.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Optional Render keep-alive settings.
RENDER_EXTERNAL_URL=
KEEPALIVE_SECONDS=600

# Supabase Sync (Optional: used by database/push_to_supabase.py)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET=your_supabase_secret_key_here
