# =============================================================================
# Prakruti — .gitignore
# Keeps the published tree to source, configs, datasets and docs only.
# Private workspace files, secrets, databases and runtime churn stay local.
# =============================================================================

# ------------------------- Secrets & environment -----------------------------
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
secrets/

# ----------------- Private workspace / agent state (never publish) -----------
# Local agent scratch state, run docs and preview logs
.freebuff/
.claude/
.continue/
# Internal engineering specs and design notes
docs/superpowers/
# Repository tooling (history-rewrite and audit scripts)
superpowers/
# Internal design document
DESIGN.md
# AI-assistant instruction files
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules

# ------------------------ Databases & binaries -------------------------------
*.db
*.sqlite
*.sqlite3
*.joblib
!database/.gitkeep
# Supabase sync tooling is environment-specific; kept out of the repo
database/push_to_supabase.py
database/supabase_schema.sql

# ------------------- Generated pipeline outputs ------------------------------
# outputs/ ships only its README and static charts; CSVs, model dumps and
# interim files are regenerated by the pipeline on demand.
outputs/*
!outputs/README.md
!outputs/charts/

# ------------------------------ Python ---------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
*.egg-info/
.venv/
venv/
env/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --------------------------- Node / Next.js ----------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
.turbo

# ------------------------------ Logs & temp ----------------------------------
*.log
logs/
tmp/
temp/
*.tmp

# ---------------------------- OS & editors -----------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------ Misc ------------------------------------------
data/archive/
.weather_cache/
