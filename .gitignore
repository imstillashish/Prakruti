__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
*.egg-info/
.venv/
venv/
env/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --------------------------- Node / Next.js ----------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
.turbo

# ------------------------------ Logs & temp ----------------------------------
*.log
logs/
tmp/
temp/
*.tmp

# ---------------------------- OS & editors -----------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------ Misc ------------------------------------------
data/archive/
.weather_cache/

# Brainstorming companion artifacts (never tracked)
.superpowers/
