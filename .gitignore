# =============================================================================
# Prakruti — .gitignore
# Keeps the published tree to source, configs, datasets and docs only.
# Private workspace files, secrets, databases and runtime churn stay local.
# =============================================================================

# ------------------------- Secrets & environment -----------------------------
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
secrets/

# ----------------- Private workspace / agent state (never publish) -----------
# Local agent scratch state, run docs and preview logs
.freebuff/
.claude/
.continue/
# Downloaded agent skill caches and tool state (per-machine)
.agents/
agent/
data/skills/
skills-lock.json
# Internal engineering specs and design notes
docs/superpowers/
# Per-machine OpenCode MCP wiring (shared rule lives in AGENTS.md)
opencode.json
# Repository tooling (history-rewrite and audit scripts)
superpowers/
# Internal design document
DESIGN.md
# Per-tool AI-assistant instruction files (shared rule lives in AGENTS.md)
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules
PRD.md
# Per-machine agent scratch space
scratch/
# Agent memory, AST knowledge graphs (graphify) and Project-Brain
.planning/
project-brain/
.brain/
.graphify/
graphify-out/
*.graphify
.graphify*

# ------------------------ Databases & binaries -------------------------------
*.db
*.sqlite
*.sqlite3
*.joblib
!database/.gitkeep
# Supabase sync tooling is environment-specific; kept out of the repo
database/push_to_supabase.py
database/supabase_schema.sql

# ------------------- Generated pipeline outputs ------------------------------
# Everything in outputs/ regenerates from the pipeline, but the API needs seed
# data on a cold server before the first regeneration finishes — the RF model
# dumps and lead weights are pipeline *inputs* and must always ship. Daily
# forecast outputs ship as a fallback snapshot; interim files stay local.
outputs/*
!outputs/README.md
!outputs/charts/
!outputs/models/
!outputs/models/*.joblib
!outputs/model_weights_lead.csv
!outputs/skill_scores_lead.csv
!outputs/blended_forecast.csv
!outputs/hybrid_forecast.csv
!outputs/confidence_scores.csv
!outputs/extreme_alerts.csv
!outputs/advisories.csv
!outputs/uncertainty.csv
!outputs/exceedance.csv
!outputs/uncertainty_diagnostics.csv
!outputs/verification.csv
!outputs/verification_categorical.csv
!outputs/verification_calibration.csv
!outputs/verification_meta.json
!outputs/cycle_state.json
!outputs/cycle_delta.json
!outputs/metadata.json

